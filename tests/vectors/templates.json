{
  "context": {
    "name": "nova_kat",
    "tier": 3,
    "amount": 1234567.891,
    "small": 12.5,
    "whole": 12,
    "neg": -2.5,
    "flag": true,
    "nothing": null,
    "list": ["a", "b", "c"],
    "obj": { "x": 1 },
    "user": { "display_name": "Nova" },
    "last.sub.name": "flat",
    "text_num": "1500"
  },
  "cases": [
    { "name": "plain text", "template": "Hello there", "expected": "Hello there" },
    { "name": "simple key", "template": "Hi {{name}}!", "expected": "Hi nova_kat!" },
    { "name": "spaces inside braces", "template": "Hi {{  name  }}!", "expected": "Hi nova_kat!" },
    { "name": "number", "template": "Tier {{tier}}", "expected": "Tier 3" },
    { "name": "nested", "template": "{{user.display_name}}", "expected": "Nova" },
    { "name": "flat dotted key", "template": "{{last.sub.name}}", "expected": "flat" },
    { "name": "missing is empty", "template": "[{{missing}}]", "expected": "[]" },
    { "name": "null is empty", "template": "[{{nothing}}]", "expected": "[]" },
    { "name": "bool", "template": "{{flag}}", "expected": "true" },
    { "name": "array joins", "template": "{{list}}", "expected": "a, b, c" },
    { "name": "object is empty", "template": "[{{obj}}]", "expected": "[]" },
    { "name": "upper", "template": "{{name | upper}}", "expected": "NOVA_KAT" },
    { "name": "lower", "template": "{{user.display_name|lower}}", "expected": "nova" },
    { "name": "number filter thousands", "template": "{{amount | number}}", "expected": "1,234,567.89" },
    { "name": "number filter small", "template": "{{small | number}}", "expected": "12.5" },
    { "name": "number filter whole", "template": "{{whole | number}}", "expected": "12" },
    { "name": "number filter numeric text", "template": "{{text_num | number}}", "expected": "1,500" },
    { "name": "number filter on text keeps text", "template": "{{name | number}}", "expected": "nova_kat" },
    { "name": "round half up", "template": "{{small | round}}", "expected": "13" },
    { "name": "round negative half", "template": "{{neg | round}}", "expected": "-2" },
    { "name": "default used when missing", "template": "{{missing | default:\"someone\"}}", "expected": "someone" },
    { "name": "default used when empty", "template": "{{nothing | default:\"someone\"}}", "expected": "someone" },
    { "name": "default ignored when present", "template": "{{name | default:\"someone\"}}", "expected": "nova_kat" },
    { "name": "chained filters", "template": "{{missing | default:\"anon\" | upper}}", "expected": "ANON" },
    { "name": "unknown filter is ignored", "template": "{{name | sparkle}}", "expected": "nova_kat" },
    { "name": "unclosed braces stay literal", "template": "Hi {{name", "expected": "Hi {{name" },
    { "name": "two in a row", "template": "{{name}}{{tier}}", "expected": "nova_kat3" },
    { "name": "single braces untouched", "template": "{name}", "expected": "{name}" },
    { "name": "empty braces stay literal", "template": "a{{}}b", "expected": "a{{}}b" }
  ]
}
