---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  items: Array<{ src: ImageMetadata; title: string; caption?: string }>;
}
const { items } = Astro.props;

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const shots = await Promise.all(
  items.map(async (item) => {
    const [main, thumb] = await Promise.all([
      getImage({ src: item.src, width: 1600, format: 'webp' }),
      getImage({ src: item.src, width: 320, format: 'webp' })
    ]);
    return { main: main.src, thumb: thumb.src, full: item.src.src, title: item.title, caption: item.caption ?? '', id: slug(item.title) };
  })
);
const first = shots[0]!;
---

<section class="viewer not-content" aria-roledescription="carousel" aria-label="Screenshots">
  <div class="stage">
    <button type="button" class="nav prev" aria-label="Previous screenshot">‹</button>
    <button type="button" class="frame" aria-label="Open full size">
      <img class="main" src={first.main} alt={first.title} width="1600" height="1000" decoding="async" />
    </button>
    <button type="button" class="nav next" aria-label="Next screenshot">›</button>
  </div>

  <div class="info" aria-live="polite">
    <p class="title"><b>{first.title}</b><span class="count">1 / {shots.length}</span></p>
    <p class="caption">{first.caption}</p>
  </div>

  <ol class="thumbs" aria-label="All screenshots">
    {
      shots.map((s, i) => (
        <li>
          <button type="button" class="thumb" data-index={i} aria-label={s.title} aria-current={i === 0 ? 'true' : undefined}>
            <img src={s.thumb} alt="" width="160" height="100" loading="lazy" decoding="async" />
          </button>
        </li>
      ))
    }
  </ol>
</section>

<dialog class="lightbox" aria-label="Full size screenshot">
  <form method="dialog"><button class="close" aria-label="Close">×</button></form>
  <img alt="" />
</dialog>

<script is:inline define:vars={{ shots }}>
  const root = document.querySelector('.viewer');
  const main = root.querySelector('.main');
  const title = root.querySelector('.title b');
  const count = root.querySelector('.count');
  const caption = root.querySelector('.caption');
  const thumbs = [...root.querySelectorAll('.thumb')];
  const strip = root.querySelector('.thumbs');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const dlg = document.querySelector('dialog.lightbox');
  const big = dlg.querySelector('img');
  const cache = new Map();
  let at = 0;

  // Load the neighbours ahead of time so stepping through has no gap.
  const warm = (i) => {
    const s = shots[(i + shots.length) % shots.length];
    if (cache.has(s.main)) return cache.get(s.main);
    const img = new Image();
    img.src = s.main;
    const ready = img.decode().catch(() => {});
    cache.set(s.main, ready);
    return ready;
  };

  const show = async (i, opts = {}) => {
    at = (i + shots.length) % shots.length;
    const s = shots[at];
    thumbs.forEach((t, n) => (n === at ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
    // Scroll only the strip, never the page.
    const t = thumbs[at];
    strip.scrollTo({ left: t.offsetLeft - strip.clientWidth / 2 + t.offsetWidth / 2, behavior: opts.instant || still.matches ? 'auto' : 'smooth' });
    title.textContent = s.title;
    count.textContent = `${at + 1} / ${shots.length}`;
    caption.textContent = s.caption;
    const mine = at;
    await warm(at);
    if (mine !== at) return;
    main.src = s.main;
    main.alt = s.title;
    if (!opts.keepHash) history.replaceState(null, '', `#${s.id}`);
    warm(at + 1);
    warm(at - 1);
  };

  root.querySelector('.prev').addEventListener('click', () => show(at - 1));
  root.querySelector('.next').addEventListener('click', () => show(at + 1));
  thumbs.forEach((t) => t.addEventListener('click', () => show(Number(t.dataset.index))));
  root.querySelector('.frame').addEventListener('click', () => {
    big.src = shots[at].full;
    big.alt = shots[at].title;
    dlg.showModal();
  });
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg || e.target === big) dlg.close();
  });

  document.addEventListener('keydown', (e) => {
    if (e.altKey || e.ctrlKey || e.metaKey) return;
    const typing = e.target instanceof HTMLElement && e.target.closest('input, textarea, [contenteditable]');
    if (typing) return;
    if (e.key === 'ArrowLeft') show(at - 1);
    else if (e.key === 'ArrowRight') show(at + 1);
    else return;
    e.preventDefault();
    if (dlg.open) {
      big.src = shots[at].full;
      big.alt = shots[at].title;
    }
  });

  const start = shots.findIndex((s) => `#${s.id}` === location.hash);
  show(start < 0 ? 0 : start, { instant: true, keepHash: start < 0 });
</script>

<style>
  /* This page has no table of contents, so give the viewer the room. */
  :global(:root:has(.viewer)) {
    --sl-content-width: 68rem;
  }
  .viewer {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .stage {
    position: relative;
  }
  /* Every screenshot sits in the same 16:10 box, so stepping through never moves the page. */
  .frame {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 16 / 10;
    padding: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    overflow: hidden;
    background: var(--sl-color-gray-6);
    cursor: zoom-in;
  }
  .main {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .nav {
    position: absolute;
    top: 50%;
    z-index: 1;
    transform: translateY(-50%);
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.6);
    color: #fff;
    font-size: 1.7rem;
    line-height: 1;
    cursor: pointer;
  }
  .nav:hover,
  .nav:focus-visible {
    background: var(--sl-color-accent);
  }
  .prev {
    left: 0.75rem;
  }
  .next {
    right: 0.75rem;
  }
  .info {
    min-height: 3.4rem;
    text-align: center;
  }
  .info p {
    margin: 0;
  }
  .title {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 0.6rem;
    color: var(--sl-color-white);
  }
  .count {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }
  .caption {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .thumbs {
    position: relative;
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0.25rem 0.25rem 0.75rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
  }
  .thumbs li {
    flex: none;
    margin: 0;
    scroll-snap-align: center;
  }
  .thumb {
    display: block;
    width: 8.5rem;
    aspect-ratio: 16 / 10;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 8px;
    overflow: hidden;
    background: var(--sl-color-gray-6);
    opacity: 0.6;
    cursor: pointer;
    transition: opacity 0.15s, border-color 0.15s;
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  .thumb:hover {
    opacity: 1;
  }
  .thumb[aria-current='true'] {
    border-color: var(--sl-color-accent);
    opacity: 1;
  }
  /* Full size view: the dialog covers the window and the image sits in its centre. */
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.85);
  }
  .lightbox form {
    position: fixed;
    top: 0;
    right: 0;
  }
  .lightbox img {
    display: block;
    margin: 0;
    max-width: 96vw;
    max-height: 92vh;
    max-height: 92dvh;
    width: auto;
    height: auto;
    border-radius: 10px;
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.5);
    cursor: zoom-out;
  }
  .close {
    position: fixed;
    top: 0.75rem;
    right: 1rem;
    z-index: 1;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.6);
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  .close:hover,
  .close:focus-visible {
    background: var(--sl-color-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .thumb {
      transition: none;
    }
  }
</style>
