{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Castwright",
  "version": "1.0.4",
  "identifier": "com.castwright.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Castwright",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Twitch broadcaster suite and overlay creator",
    "longDescription": "Castwright is a local-first Twitch broadcaster suite: overlays, alerts, chat and automation in one app, with OBS as the video engine.",
    "copyright": "Copyright (c) 2026 karasu",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0MUZDQUIyN0EzN0YyNUIKUldSYjhqZDZzc29mSkRWUlpocUdvS1ZzWGd2ak5xZklGMTltV3Z4NUYzaVNHVHc0VEV5OGhpZGQK",
      "endpoints": [
        "https://github.com/AmeliaFromFinance/Castwright/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
