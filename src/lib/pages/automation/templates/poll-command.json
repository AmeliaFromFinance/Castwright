              "step": {
                "type": "run_script",
                "code": "// !poll Question | Choice 1 | Choice 2 (up to 5 choices)\nlet out = [];\nfor part in args.input.split(\"|\") {\n    let t = part;\n    t.trim();\n    if t != \"\" { out.push(t); }\n}\nlet ok = out.len() >= 3 && out.len() <= 6;\nset(\"poll_cmd.ok\", ok);\nset(\"poll_cmd.title\", if ok { out[0] } else { \"\" });\nfor i in 1..6 {\n    set(\"poll_cmd.choice\" + i, if ok && i < out.len() { out[i] } else { \"\" });\n}"
              }
            }
          },
          {
            "id": "n3",
            "x": 164,
            "y": 336,
            "kind": {
